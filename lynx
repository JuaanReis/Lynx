#!/bin/bash

# Cores
RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m' # Sem cor

# Funções de print
info() { echo -e "${CYAN}[INFO]${NC} $1"; }
erro() { echo -e "${RED}[ERRO]${NC} $1"; }
ok()   { echo -e "${GREEN}[OK]${NC} $1"; }

# Checar se o requirements.txt existe
if [ ! -f "requirements.txt" ]; then
    erro "Arquivo requirements.txt não encontrado!"
    exit 1
fi

# Checar se o venv existe
if [ ! -d "venv" ]; then
    info "Criando ambiente virtual..."
    python3 -m venv venv || { erro "Falha ao criar venv"; exit 1; }
    source venv/bin/activate
    info "Instalando dependências..."
    pip install -r requirements.txt || { erro "Falha ao instalar requirements"; exit 1; }
    ok "Ambiente virtual pronto!"
else
    ok "Ativando ambiente virtual existente..."
    source venv/bin/activate
fi

# Tenta iniciar o Tor
if command -v tor &> /dev/null; then
    info "Iniciando serviço Tor em background..."
    tor &> /dev/null &
    sleep 3
    if pgrep -x tor > /dev/null; then
        ok "Tor iniciado com sucesso!"
    else
        erro "Falha ao iniciar o Tor. Verifique se está tudo certo com a instalação."
    fi
else
    erro "Tor não está instalado."
    read -p "Deseja instalar o Tor agora? [s/N]: " resposta
    if [[ "$resposta" =~ ^[sS]$ ]]; then
        if command -v apt &> /dev/null; then
            info "Instalando Tor com apt..."
            sudo apt update && sudo apt install -y tor || { erro "Falha ao instalar Tor"; exit 1; }
            ok "Tor instalado!"
            tor &> /dev/null &
        else
            erro "Gerenciador de pacotes não suportado automaticamente. Instale o Tor manualmente."
            exit 1
        fi
    else
        erro "Tor não instalado. Abortando execução."
        exit 1
    fi
fi

# Rodar o main.py em novo terminal (se tiver gnome-terminal)
if command -v gnome-terminal &> /dev/null; then
    info "Abrindo gnome-terminal e rodando main.py..."
    gnome-terminal -- bash -c "python3 main.py; exec bash"
else
    info "Rodando no terminal atual (gnome-terminal não encontrado)..."
    python3 main.py
fi
